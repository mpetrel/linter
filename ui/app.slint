// A Typora-style live preview Markdown editor.
//
// The document is a column of blocks. Each block is shown rendered; clicking
// one (or moving into it with the arrow keys) swaps it for its raw Markdown
// in place, so `## Title` can become `### Title` by typing another `#`.

import { AboutSlint, ListView, Palette } from "std-widgets.slint";

export enum BlockKind { empty, paragraph, heading, code, quote, list, rule, table, image, raw }

export struct Line {
    indent: int,
    marker: string,
    task: int,          // 0: none, 1: open, 2: done
    text: styled-text,
    code: string,
    is-code: bool,
}

export struct Cell {
    text: styled-text,
    align: int,         // 0: left, 1: center, 2: right
}

export struct Row {
    cells: [Cell],
    header: bool,
}

export struct Block {
    kind: BlockKind,
    level: int,
    source: string,
    lines: [Line],
    code: string,
    lang: string,
    rows: [Row],
    col-weights: [float],
    image: image,
    has-image: bool,
    caption: string,
}

// The modifier keys held, as a key event reports them.
export struct Modifiers {
    control: bool,
    alt: bool,
    shift: bool,
    meta: bool,
}

// action: 0 = let the text field handle the key, 1 = handled, 2 = replace text
export struct EditResult {
    action: int,
    text: string,
    anchor: int,
    cursor: int,
}

// Colours for the light and dark themes. Switch with App.apply-theme(), which
// also switches the std widgets (the scroll bar) to match.
export global Theme {
    in-out property <bool> dark;
    out property <color> page: dark ? #0d1117 : #ffffff;
    out property <color> ink: dark ? #e6edf3 : #1f2328;
    out property <color> soft: dark ? #9198a1 : #59636e;
    out property <color> muted: dark ? #6e7681 : #8c959f;
    out property <color> accent: dark ? #4493f8 : #0969da;
    // Filled accent behind white text: checked boxes, badges, the default button.
    out property <color> accent-fill: dark ? #1f6feb : #0969da;
    out property <color> accent-pressed: dark ? #1158c7 : #0758b8;
    out property <color> on-accent: #ffffff;
    out property <color> rule: dark ? #3d444d : #d1d9e0;
    out property <color> code-bg: dark ? #151b23 : #f6f8fa;
    out property <color> edit-bg: dark ? #121a25 : #f3f6fa;
    out property <color> chrome: dark ? #151b23 : #f6f8fa;
    out property <color> quote-bar: dark ? #3d444d : #d1d9e0;
    out property <color> row-alt: dark ? #10151c : #fafbfc;
    out property <color> selection: dark ? #264f78 : #b6d7ff;
    // Neutral fill on the page: block type badge, hovered dialog button.
    out property <color> subtle: dark ? #262c36 : #eef1f4;
    out property <color> hover: dark ? #262c36 : #e8ecf0;
    out property <color> pressed: dark ? #2f3742 : #dde3ea;
    out property <color> danger: dark ? #f85149 : #cf222e;
    out property <color> scrim: dark ? #010409b3 : #1f232866;
    out property <color> shadow: dark ? #00000099 : #00000040;
    out property <length> body: 16px;
    out property <length> mono-size: 14px;
    in-out property <string> mono: "Noto Sans Mono";
    out property <length> column: 820px;

    public pure function heading-size(level: int) -> length {
        level == 1 ? 30px : level == 2 ? 25px : level == 3 ? 21px : level == 4 ? 18px : level == 5 ? 16px : 15px
    }
}

// Icons are drawn as paths, not text: symbols such as ✓ or 🖼 are missing from
// Segoe UI, the default font on Windows, and show there as a box.
component CheckMark inherits Path {
    width: 12px;
    height: 12px;
    viewbox-width: 12;
    viewbox-height: 12;
    commands: "M 2.25 6.25 L 5 9 L 9.75 3.25";
    stroke-width: 1.75px;
    stroke-line-cap: round;
}

component PictureIcon inherits Path {
    width: 16px;
    height: 14px;
    viewbox-width: 16;
    viewbox-height: 14;
    commands: "M 1.5 1.5 L 14.5 1.5 L 14.5 12.5 L 1.5 12.5 Z M 1.5 10 L 5.5 6 L 9 9.5 L 11 7.5 L 14.5 11 M 10.5 4.5 A 1 1 0 1 0 12.5 4.5 A 1 1 0 1 0 10.5 4.5";
    stroke-width: 1.25px;
    stroke-line-cap: round;
}

component FlowLines inherits VerticalLayout {
    in property <[Line]> lines;
    in property <color> color: Theme.ink;
    spacing: 6px;

    for line in root.lines: HorizontalLayout {
        padding-left: line.indent * 26px;
        spacing: 8px;

        if line.marker != "" && line.task == 0: Text {
            text: line.marker;
            color: Theme.soft;
            font-size: Theme.body;
            min-width: 18px;
            horizontal-alignment: right;
            vertical-alignment: top;
        }
        if line.task != 0: VerticalLayout {
            alignment: start;
            padding-top: 3px;
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 4px;
                border-width: line.task == 2 ? 0px : 1.5px;
                border-color: Theme.muted;
                background: line.task == 2 ? Theme.accent-fill : Theme.page;
                if line.task == 2: CheckMark {
                    stroke: Theme.on-accent;
                    stroke-width: 2px;
                }
            }
        }
        if !line.is-code: StyledText {
            text: line.text;
            default-color: root.color;
            default-font-size: Theme.body;
            link-color: Theme.accent;
            horizontal-stretch: 1;
        }
        if line.is-code: Rectangle {
            horizontal-stretch: 1;
            background: Theme.code-bg;
            border-radius: 4px;
            HorizontalLayout {
                padding: 8px;
                Text {
                    text: line.code;
                    font-family: Theme.mono;
                    font-size: Theme.mono-size;
                    color: Theme.ink;
                    wrap: word-wrap;
                }
            }
        }
    }
}

component CodeBox inherits Rectangle {
    in property <string> code;
    in property <string> lang;
    in property <bool> raw;
    background: Theme.code-bg;
    border-radius: 6px;
    border-width: root.raw ? 1px : 0px;
    border-color: Theme.rule;

    VerticalLayout {
        padding: 12px;
        padding-left: 16px;
        padding-right: 16px;
        Text {
            text: root.code == "" ? " " : root.code;
            font-family: Theme.mono;
            font-size: Theme.mono-size;
            color: root.raw ? Theme.soft : Theme.ink;
            wrap: word-wrap;
        }
    }
    if root.lang != "": Text {
        x: parent.width - self.width - 10px;
        y: 5px;
        text: root.lang;
        font-size: 11px;
        color: Theme.muted;
    }
}

// The rounded frame is drawn on top of the rows instead of clipping them: a
// rounded clip makes Slint 1.19's software renderer panic once the table is
// more than 32767 physical pixels away from the viewport (slint-ui/slint#14998).
component TableView {
    in property <[Row]> rows;
    in property <[float]> weights;
    property <length> radius: 6px;

    VerticalLayout {
        for row[r] in root.rows: Rectangle {
            background: row.header ? Theme.code-bg : Math.mod(r, 2) == 0 ? Theme.page : Theme.row-alt;
            border-top-left-radius: r == 0 ? root.radius : 0px;
            border-top-right-radius: r == 0 ? root.radius : 0px;
            border-bottom-left-radius: r == root.rows.length - 1 ? root.radius : 0px;
            border-bottom-right-radius: r == root.rows.length - 1 ? root.radius : 0px;
            HorizontalLayout {
                for cell[c] in row.cells: Rectangle {
                    width: root.width * root.weights[c];
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 7px;
                        padding-bottom: 7px;
                        StyledText {
                            text: cell.text;
                            default-font-size: Theme.body - 1px;
                            default-color: Theme.ink;
                            link-color: Theme.accent;
                            horizontal-alignment: cell.align == 1 ? TextHorizontalAlignment.center : cell.align == 2 ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        }
                    }
                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        background: Theme.rule;
                        visible: c < row.cells.length - 1;
                    }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.rule;
                visible: r < root.rows.length - 1;
            }
        }
    }
    Rectangle {
        border-width: 1px;
        border-color: Theme.rule;
        border-radius: root.radius;
    }
}

// What the window asks the row of the block being edited. The list only
// creates the rows in view and places them by estimated heights, so a row's
// position is only meaningful while it exists: rather than remember where the
// block was, the window asks, and a missing answer means it has no row.
enum Ask {
    // Take the focus and scroll the caret into view.
    reveal,
    // The list stopped moving: take the focus back if that doesn't scroll.
    settle,
    // The list moved: only answer, so the window knows the row is still there.
    probe,
}

component BlockView {
    in property <Block> data;
    in property <int> index;
    in property <bool> editing;
    in property <int> edit-seq;
    in property <int> cursor-request: -1;
    in property <bool> placeholder;
    // The caret the window saved for edit session `caret-seq`, to put it back
    // when the block being edited is created again after scrolling out of view.
    in property <int> caret-seq: -1;
    in property <int> saved-caret;
    in property <int> saved-anchor;
    // The window's question to the block being edited; `ask-seq` changes with
    // each one.
    in property <int> ask-seq;
    in property <Ask> ask;
    // Whether taking the focus now would leave the list where it is.
    in property <bool> resumable;
    out property <length> input-top: input.y;
    out property <length> input-height: input.height;

    // cursor: -2 keep the cursor where the click put it, 0 start, -1 end
    callback request-edit(index: int, cursor: int);
    callback edited(index: int, text: string);
    callback key-action(index: int, command: string, text: string, cursor: int, anchor: int) -> EditResult;
    callback release-focus();
    // While editing: the caret's byte offsets and its top, relative to this
    // block, and whether to scroll it into view.
    callback caret-moved(caret: int, anchor: int, caret-y: length, line-h: length, scroll: bool);
    // While editing: the window's question was answered.
    callback answered();
    // Created while being edited.
    callback created();
    // While editing: the text field got the focus.
    callback focused();

    property <bool> mono: data.kind == BlockKind.code || data.kind == BlockKind.raw || data.kind == BlockKind.table;
    property <length> font-size: data.kind == BlockKind.heading ? Theme.heading-size(data.level) : root.mono ? Theme.mono-size : Theme.body;
    property <length> pad-top: data.kind == BlockKind.heading ? (data.level <= 2 ? 18px : 12px) : 6px;
    property <length> pad-bottom: data.kind == BlockKind.heading && data.level <= 2 ? 8px : 6px;
    property <length> line-h: max(root.font-size * 1.2, input.font-metrics.ascent + abs(input.font-metrics.descent));
    property <length> caret-y;
    property <string> src: data.source;
    // Changes whenever the editor (re)starts editing this block.
    property <int> sync: root.editing ? root.edit-seq : -1;
    // The edit session whose caret this text field holds: until then, its
    // caret moves aren't reported.
    property <int> started-seq: -1;
    property <bool> scroll-to-caret: true;

    height: root.editing ? max(input.preferred-height, root.line-h) + root.pad-top + root.pad-bottom : view.preferred-height;

    init => {
        input.text = root.data.source;
        if root.editing {
            // Created while being edited: the window brought the block into
            // view, or the user scrolled back to it. Put the caret back, but
            // leave the focus to the window, which asks once the list settles.
            if root.caret-seq == root.edit-seq {
                root.start-editing(false, false);
            }
            root.created();
        }
    }
    changed sync => {
        if root.editing {
            root.start-editing(true, true);
        } else {
            root.stop-editing();
        }
    }
    changed src => {
        if !root.editing && input.text != root.src {
            input.text = root.src;
        }
    }
    changed ask-seq => {
        if root.editing {
            if root.ask == Ask.reveal {
                root.start-editing(true, true);
            } else if root.ask == Ask.settle && !input.has-focus && root.resumable {
                root.start-editing(true, false);
            }
            root.answered();
        }
    }

    // Puts the caret of this edit session in the text field: the one the
    // window saved if the session already had one, or else the one asked for.
    function start-editing(focus: bool, scroll: bool) {
        if input.text != root.data.source {
            input.text = root.data.source;
        }
        let resuming = root.caret-seq == root.edit-seq;
        root.started-seq = root.edit-seq;
        root.scroll-to-caret = scroll;
        if resuming && !input.has-focus {
            input.set-selection-offsets(root.saved-anchor, root.saved-caret);
        }
        if focus && !input.has-focus {
            input.focus();
        }
        if !resuming && root.cursor-request >= 0 {
            input.set-selection-offsets(root.cursor-request, root.cursor-request);
        }
        root.report-caret();
        root.scroll-to-caret = true;
    }

    function stop-editing() {
        if input.has-focus {
            input.clear-focus();
            root.release-focus();
        }
        if input.text != root.data.source {
            input.text = root.data.source;
        }
    }

    function report-caret() {
        root.caret-moved(input.cursor-position-byte-offset, input.anchor-position-byte-offset, input.y + root.caret-y, root.line-h, root.scroll-to-caret);
    }

    function act(command: string) -> EventResult {
        let r = root.key-action(root.index, command, input.text, input.cursor-position-byte-offset, input.anchor-position-byte-offset);
        if r.action == 0 {
            return EventResult.reject;
        }
        if r.action == 2 {
            input.text = r.text;
            input.set-selection-offsets(r.anchor, r.cursor);
        }
        return EventResult.accept;
    }

    pure function kind-label() -> string {
        data.kind == BlockKind.heading ? "H\{data.level}" : data.kind == BlockKind.code ? "code" : data.kind == BlockKind.quote ? "quote" : data.kind == BlockKind.list ? "list" : data.kind == BlockKind.table ? "table" : data.kind == BlockKind.image ? "image" : data.kind == BlockKind.rule ? "rule" : data.kind == BlockKind.raw ? "raw" : "text"
    }

    // Edit-mode highlight, reaching into the margins so the text doesn't move.
    Rectangle {
        x: -14px;
        width: parent.width + 28px;
        border-radius: 6px;
        background: root.editing ? Theme.edit-bg : transparent;
        Rectangle {
            x: 0;
            y: 6px;
            width: 3px;
            height: parent.height - 12px;
            border-radius: 1.5px;
            background: root.editing ? Theme.accent : transparent;
        }
    }

    area := TouchArea {
        mouse-cursor: MouseCursor.text;
        // Clicks in the padding around the text: start or end of the block.
        clicked => {
            root.request-edit(root.index, self.mouse-y < input.y ? 0 : -1);
        }

        view := VerticalLayout {
            x: 0;
            y: 0;
            width: parent.width;
            height: self.preferred-height;
            visible: !root.editing;
            padding-top: root.pad-top;
            padding-bottom: root.pad-bottom;

            if data.kind == BlockKind.heading: VerticalLayout {
                spacing: 8px;
                StyledText {
                    text: data.lines[0].text;
                    default-font-size: Theme.heading-size(data.level);
                    default-color: data.level == 6 ? Theme.soft : Theme.ink;
                    link-color: Theme.accent;
                }
                if data.level <= 2: Rectangle {
                    height: 1px;
                    background: Theme.rule;
                }
            }
            if data.kind == BlockKind.paragraph || data.kind == BlockKind.list: FlowLines {
                lines: data.lines;
            }
            if data.kind == BlockKind.quote: HorizontalLayout {
                spacing: 14px;
                Rectangle {
                    width: 4px;
                    border-radius: 2px;
                    background: Theme.quote-bar;
                }
                FlowLines {
                    lines: data.lines;
                    color: Theme.soft;
                }
            }
            if data.kind == BlockKind.code || data.kind == BlockKind.raw: CodeBox {
                code: data.code;
                lang: data.lang;
                raw: data.kind == BlockKind.raw;
            }
            if data.kind == BlockKind.rule: VerticalLayout {
                padding-top: 10px;
                padding-bottom: 10px;
                Rectangle {
                    height: 2px;
                    background: Theme.rule;
                }
            }
            if data.kind == BlockKind.table: TableView {
                rows: data.rows;
                weights: data.col-weights;
            }
            if data.kind == BlockKind.image && data.has-image: HorizontalLayout {
                alignment: start;
                Image {
                    source: data.image;
                    width: min(root.width, data.image.width * 1px);
                    height: self.width * data.image.height / max(1, data.image.width);
                }
            }
            if data.kind == BlockKind.image && !data.has-image: Rectangle {
                border-width: 1px;
                border-color: Theme.rule;
                border-radius: 6px;
                background: Theme.code-bg;
                HorizontalLayout {
                    padding: 14px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: start;
                        padding-top: 2px;
                        PictureIcon {
                            stroke: Theme.soft;
                        }
                    }
                    Text {
                        text: data.caption;
                        color: Theme.soft;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }
            }
            if data.kind == BlockKind.empty: Text {
                text: root.placeholder ? "Click here and start writing Markdown…" : "";
                color: Theme.muted;
                font-size: Theme.body;
                min-height: Theme.body * 1.4;
            }
        }

        input := TextInput {
            x: 0;
            y: root.pad-top;
            width: parent.width;
            height: root.editing ? max(self.preferred-height, root.line-h) : max(0px, parent.height - root.pad-top - root.pad-bottom);
            visible: root.editing || area.has-hover;
            single-line: false;
            wrap: word-wrap;
            vertical-alignment: top;
            font-size: root.font-size;
            font-weight: data.kind == BlockKind.heading ? 700 : 400;
            font-family: root.mono ? Theme.mono : "";
            // Lists and quotes render one row per line with 6px spacing; match it
            // so a click lands on the same line in the raw text.
            line-height-factor: data.kind == BlockKind.list || data.kind == BlockKind.quote ? (root.line-h + 6px) / root.line-h : 1;
            color: !root.editing ? transparent : data.kind == BlockKind.heading && data.level == 6 ? Theme.soft : Theme.ink;
            selection-background-color: Theme.selection;
            selection-foreground-color: Theme.ink;

            edited => {
                root.edited(root.index, self.text);
            }
            cursor-position-changed(pos) => {
                root.caret-y = pos.y;
                if root.editing && root.started-seq == root.edit-seq {
                    root.report-caret();
                }
            }
            changed has-focus => {
                if self.has-focus && !root.editing {
                    root.request-edit(root.index, -2);
                } else if self.has-focus {
                    if root.started-seq != root.edit-seq {
                        // Clicked before the window brought the block into
                        // view: the caret is where the click put it.
                        root.started-seq = root.edit-seq;
                        root.report-caret();
                    }
                    root.focused();
                }
            }
            key-pressed(e) => {
                if e.text == Key.Escape {
                    return root.act("escape");
                }
                if e.text == Key.Return {
                    if e.modifiers.shift {
                        return EventResult.reject;
                    }
                    return root.act(e.modifiers.control ? "ctrl-enter" : "enter");
                }
                if e.text == Key.Backtab || (e.text == Key.Tab && e.modifiers.shift) {
                    return root.act("backtab");
                }
                if e.text == Key.Tab {
                    return root.act("tab");
                }
                if e.text == Key.Backspace && !e.modifiers.control {
                    return root.act("backspace");
                }
                if e.text == Key.Delete && !e.modifiers.control {
                    return root.act("delete");
                }
                if e.text == Key.UpArrow && !e.modifiers.shift && root.caret-y < root.line-h * 0.5 {
                    return root.act("up");
                }
                if e.text == Key.DownArrow && !e.modifiers.shift && root.caret-y + root.line-h * 1.5 > self.height {
                    return root.act("down");
                }
                if e.modifiers.control && !e.modifiers.alt {
                    if e.text == "=" || e.text == "+" {
                        return root.act("promote");
                    }
                    if e.text == "-" || e.text == "_" {
                        return root.act("demote");
                    }
                    if e.text == "0" || e.text == "1" || e.text == "2" || e.text == "3" || e.text == "4" || e.text == "5" || e.text == "6" {
                        return root.act("h" + e.text);
                    }
                    if e.text == "b" || e.text == "B" {
                        return root.act("bold");
                    }
                    if e.text == "i" || e.text == "I" {
                        return root.act("italic");
                    }
                }
                return EventResult.reject;
            }
        }

        if root.editing && input.text == "": Text {
            x: input.x;
            y: input.y;
            text: "Type Markdown…   # heading   - list   > quote   ``` code";
            color: Theme.muted;
            font-size: Theme.body;
        }
    }

    // Block type badge in the left margin.
    if root.editing || area.has-hover: Rectangle {
        x: -62px;
        y: root.pad-top + max(0px, (min(root.line-h, root.height) - 18px) / 2);
        width: 40px;
        height: 18px;
        border-radius: 4px;
        background: root.editing ? Theme.accent-fill : Theme.subtle;
        Text {
            text: root.kind-label();
            font-size: 11px;
            color: root.editing ? Theme.on-accent : Theme.soft;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// One row of the document list: a block in the centred text column, the
// margins beside it, and the space above the first block and below the last.
component BlockRow {
    in property <Block> data;
    in property <int> index;
    in property <bool> first;
    in property <bool> last;
    in property <length> column-x;
    in property <length> column-width;
    in property <bool> editing;
    in property <int> edit-seq;
    in property <int> cursor-request: -1;
    in property <bool> placeholder;
    in property <int> caret-seq: -1;
    in property <int> saved-caret;
    in property <int> saved-anchor;
    in property <int> ask-seq;
    in property <Ask> ask;
    // The part of the list in view, in list content coordinates.
    in property <length> view-top;
    in property <length> view-height;

    callback request-edit(index: int, cursor: int);
    callback edited(index: int, text: string);
    callback key-action(index: int, command: string, text: string, cursor: int, anchor: int) -> EditResult;
    callback release-focus();
    // `caret-y` is in list content coordinates, valid only until the list
    // lays out again.
    callback caret-moved(index: int, caret: int, anchor: int, caret-y: length, line-h: length, scroll: bool);
    callback answered(index: int);
    callback created(index: int);
    callback focused(index: int);
    callback click-blank();
    callback click-below();
    // The list shows the row of an image block: its image loads now. The row
    // asks again whenever its data is set, which Rust does to have the rows
    // in view load their image again.
    callback show-image(index: int);

    init => {
        root.check-image();
    }
    changed data => {
        root.check-image();
    }
    function check-image() {
        if root.data.kind == BlockKind.image {
            root.show-image(root.index);
        }
    }

    property <length> pad-top: root.first ? 36px : 0px;
    property <length> pad-bottom: root.last ? 160px : 0px;
    height: root.pad-top + block.height + root.pad-bottom;

    // A focused text field scrolls the list to show all of itself, unless it's
    // taller than the view.
    property <length> input-top: root.y + root.pad-top + block.input-top;
    property <bool> resumable: block.input-height > root.view-height || (root.input-top >= root.view-top && root.input-top + block.input-height <= root.view-top + root.view-height);

    TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => {
            if root.last && self.mouse-y > root.pad-top + block.height {
                root.click-below();
            } else {
                root.click-blank();
            }
        }
    }

    block := BlockView {
        x: root.column-x;
        y: root.pad-top;
        width: root.column-width;
        data: root.data;
        index: root.index;
        editing: root.editing;
        edit-seq: root.edit-seq;
        cursor-request: root.cursor-request;
        placeholder: root.placeholder;
        caret-seq: root.caret-seq;
        saved-caret: root.saved-caret;
        saved-anchor: root.saved-anchor;
        ask-seq: root.ask-seq;
        ask: root.ask;
        resumable: root.resumable;
        request-edit(index, cursor) => {
            root.request-edit(index, cursor);
        }
        edited(index, text) => {
            root.edited(index, text);
        }
        key-action(index, command, text, cursor, anchor) => {
            return root.key-action(index, command, text, cursor, anchor);
        }
        release-focus => {
            root.release-focus();
        }
        caret-moved(caret, anchor, caret-y, line-h, scroll) => {
            root.caret-moved(root.index, caret, anchor, root.y + root.pad-top + caret-y, line-h, scroll);
        }
        answered => {
            root.answered(root.index);
        }
        created => {
            root.created(root.index);
        }
        focused => {
            root.focused(root.index);
        }
    }
}

component ToolButton inherits Rectangle {
    in property <string> text;
    in property <string> shortcut;
    callback clicked;
    height: 28px;
    min-width: label.preferred-width + 22px;
    border-radius: 6px;
    background: ta.pressed ? Theme.pressed : ta.has-hover ? Theme.hover : transparent;

    label := Text {
        text: root.text;
        color: Theme.ink;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component DialogButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    callback clicked;
    height: 32px;
    min-width: label.preferred-width + 28px;
    border-radius: 6px;
    background: root.primary ? (ta.pressed ? Theme.accent-pressed : Theme.accent-fill) : (ta.pressed ? Theme.pressed : ta.has-hover ? Theme.subtle : Theme.page);
    border-width: root.primary ? 0px : 1px;
    border-color: Theme.rule;

    label := Text {
        text: root.text;
        color: root.primary ? Theme.on-accent : Theme.ink;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component MenuEntry inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    callback clicked;
    height: 30px;
    border-radius: 4px;
    background: ta.has-hover ? Theme.hover : transparent;

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 14px;
        spacing: 4px;
        Rectangle {
            width: 20px;
            if root.checked: CheckMark {
                stroke: Theme.accent;
            }
        }
        Text {
            text: root.text;
            color: Theme.ink;
            font-size: 13px;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Toolbar button that opens a menu to pick the light or dark theme.
component ThemeMenu inherits Rectangle {
    callback choose(dark: bool);
    height: 28px;
    width: label.preferred-width + 38px;
    border-radius: 6px;
    background: ta.pressed ? Theme.pressed : ta.has-hover ? Theme.hover : transparent;

    label := Text {
        x: 11px;
        height: parent.height;
        text: "Theme";
        color: Theme.ink;
        font-size: 13px;
        vertical-alignment: center;
    }
    Path {
        x: parent.width - 20px;
        y: (parent.height - self.height) / 2 + 1px;
        width: 9px;
        height: 5px;
        viewbox-width: 9;
        viewbox-height: 5;
        commands: "M 0.75 0.75 L 4.5 4.25 L 8.25 0.75";
        stroke: Theme.soft;
        stroke-width: 1.5px;
    }
    ta := TouchArea {
        clicked => {
            popup.show();
        }
    }

    // Transparent margin around the card leaves room for its shadow.
    popup := PopupWindow {
        x: parent.width - self.width + 8px;
        y: parent.height - 4px;
        width: 176px;
        height: menu.preferred-height + 16px;
        Rectangle {
            x: 8px;
            y: 8px;
            width: parent.width - 16px;
            height: parent.height - 16px;
            background: Theme.page;
            border-width: 1px;
            border-color: Theme.rule;
            border-radius: 8px;
            drop-shadow-blur: 12px;
            drop-shadow-offset-y: 2px;
            drop-shadow-color: Theme.shadow;
            menu := VerticalLayout {
                padding: 4px;
                MenuEntry {
                    text: "Light";
                    checked: !Theme.dark;
                    clicked => {
                        root.choose(false);
                    }
                }
                MenuEntry {
                    text: "Dark";
                    checked: Theme.dark;
                    clicked => {
                        root.choose(true);
                    }
                }
            }
        }
    }
}

export component App inherits Window {
    title: (root.modified ? "● " : "") + root.file-name + " — linter";
    icon: @image-url("../assets/linter.png");
    preferred-width: 1040px;
    preferred-height: 780px;
    min-width: 520px;
    min-height: 360px;
    background: Theme.page;

    in property <[Block]> blocks;
    in property <int> editing-index: -1;
    in property <int> edit-seq;
    in property <int> cursor-request: -1;
    in property <string> file-name: "Untitled";
    in property <string> file-path;
    in property <bool> modified;
    in property <string> status;
    in property <bool> status-error;
    in property <int> words;
    in property <int> chars;
    in property <bool> doc-blank;
    in property <bool> confirm-open;
    in property <string> confirm-text;
    in property <bool> drop-hover;
    // Shown in the About dialog.
    in property <string> version;
    out property <bool> about-open;

    callback edited(index: int, text: string);
    callback key-action(index: int, command: string, text: string, cursor: int, anchor: int) -> EditResult;
    callback request-edit(index: int, cursor: int);
    callback click-below();
    callback open-file();
    callback save-file();
    callback save-file-as();
    callback confirm-choice(choice: int);
    callback focus-root();
    // Click on empty space beside or above the document.
    callback click-blank();
    callback choose-theme(dark: bool);
    // Esc while the block being edited is scrolled out of view.
    callback finish-edit();
    // The document list scrolled.
    callback list-scrolled();
    // Any other key then: types `text` into that block if it's text and no
    // modifier but Shift is held. Returns whether the key was used.
    callback key-away(text: string, modifiers: Modifiers) -> bool;
    // The text field of the block being edited got the focus (back).
    callback edit-focused();
    // The list shows the row of image block `index`.
    callback show-image(index: int);

    // The caret of edit session `caret-seq`, saved as the block being edited
    // reports it, so that it can be put back when that block is created again
    // after scrolling out of view. Rust moves it when it types into the block.
    in-out property <int> caret-seq: -1;
    in-out property <int> saved-caret;
    in-out property <int> saved-anchor;
    // The modifier keys held now, as of the last key event: Rust replays keys
    // with the modifiers they were pressed with, and puts these back after.
    out property <Modifiers> modifiers;
    property <length> column-x: max(80px, (sv.visible-width - Theme.column) / 2);
    property <length> column-width: min(Theme.column, sv.visible-width - 160px);

    // The list only creates the rows in view, so the block being edited has no
    // text field while it's scrolled away, and a text field that is dropped
    // while it has the focus takes the keys with it. So the window holds the
    // focus whenever the list may move, and asks the block's row, if there is
    // one, to take it back (see Ask). Keys the window gets meanwhile go to
    // key-away.
    property <int> ask-seq;
    property <Ask> sent-ask;
    // The edit session `sent-ask` was asked in.
    property <int> sent-edit-seq;
    property <bool> answered;
    property <bool> ask-pending;
    property <Ask> next-ask;
    property <bool> check-pending;
    // Asked to reveal the block, it had no row: the list is scrolling to it.
    property <bool> want-reveal;
    // Reveals that went unanswered since `bring-back`. The list places rows
    // by estimated heights, so a row it creates for a reveal may be gone again
    // before it's asked; after a few tries the window keeps the focus, and
    // the next key tries again.
    property <int> reveal-tries;
    property <length> view-height: sv.visible-height;
    // A dialog keeps the focus while it's open.
    property <bool> modal-open: root.about-open || root.confirm-open;

    // A new document starts at its top.
    public function scroll-to-top() {
        sv.content-y = 0;
    }

    // Scrolls the caret of the block being edited into view, bringing the block
    // into the list first if it's out of view.
    public function bring-back() {
        root.reveal-tries = 0;
        root.ask(Ask.reveal);
    }

    // Before the list may move (Rust calls this on a mouse wheel event). The
    // block takes the focus back once the list stops, even if it didn't move.
    public function park-focus() {
        if root.editing-index >= 0 {
            fs.focus();
            root.settle();
        }
    }

    // Asks the row of the block being edited `a`, on the next tick. A reveal
    // waiting to be asked isn't replaced by another question, nor a settle by
    // a probe.
    function ask(a: Ask) {
        if root.editing-index < 0 {
            return;
        }
        if root.ask-pending && (root.next-ask == Ask.reveal || (root.next-ask == Ask.settle && a == Ask.probe)) {
            return;
        }
        root.next-ask = a;
        root.ask-pending = true;
    }

    pure function revealing() -> bool {
        return root.want-reveal || (root.ask-pending && root.next-ask == Ask.reveal) || (root.check-pending && root.sent-ask == Ask.reveal);
    }

    // A new edit session: make sure its block is in view, since it may not
    // have a row yet (moving down from the last line on screen, say).
    changed edit-seq => {
        root.want-reveal = false;
        if root.editing-index >= 0 {
            root.bring-back();
        }
    }
    changed view-height => {
        root.list-moved();
    }

    // The list moved, or its view changed size.
    function list-moved() {
        root.settle();
        // A text field that had the focus is gone if its row is (the scroll
        // bar moved the list, say), and the keys with it: ask whether the row
        // is there, and hold the focus if it isn't.
        if !root.revealing() {
            root.ask(Ask.probe);
        }
    }

    function settle() {
        if root.editing-index >= 0 {
            settle-timer.start();
            settle-timer.restart();
        }
    }

    // The list stopped moving.
    settle-timer := Timer {
        interval: 80ms;
        running: false;
        triggered => {
            self.stop();
            if root.editing-index >= 0 && !root.revealing() && !root.modal-open {
                root.ask(Ask.settle);
            }
        }
    }

    // Asks on one tick, after any layout in between, and looks at the answer
    // on the next: rows answer from a change handler.
    ask-timer := Timer {
        interval: 1ms;
        running: root.ask-pending || root.check-pending;
        triggered => {
            root.ask-step();
        }
    }

    function ask-step() {
        if root.check-pending {
            root.check-pending = false;
            if !root.answered && root.editing-index >= 0 && root.sent-edit-seq == root.edit-seq && !root.modal-open {
                if root.sent-ask != Ask.reveal {
                    // No row: hold the focus for it.
                    fs.focus();
                } else if root.reveal-tries < 4 {
                    // No row: scroll the list to the block. Its row asks for
                    // another try when it's created.
                    root.reveal-tries += 1;
                    root.want-reveal = true;
                    sv.ensure-row-visible(root.editing-index, ScrollBehavior.instant);
                } else {
                    root.want-reveal = false;
                    fs.focus();
                }
            }
        }
        if root.ask-pending {
            root.ask-pending = false;
            // Not while a dialog is open: closing it asks again.
            if root.editing-index >= 0 && !root.modal-open {
                root.sent-ask = root.next-ask;
                root.sent-edit-seq = root.edit-seq;
                root.answered = false;
                root.ask-seq += 1;
                root.check-pending = true;
            }
        }
    }

    public function apply-theme(dark: bool) {
        Theme.dark = dark;
        Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
    }

    focus-root => {
        fs.focus();
    }

    // While a dialog is open, the window takes the focus from the block being
    // edited, so that an input method can't type into it behind the dialog.
    // On close, the block takes it back where it is, without scrolling to it.
    function show-about() {
        root.about-open = true;
        fs.focus();
    }

    function close-about() {
        root.about-open = false;
        root.dialog-closed();
    }

    function dialog-closed() {
        if !root.modal-open {
            root.ask(Ask.settle);
        }
    }

    changed confirm-open => {
        if root.confirm-open {
            // One dialog at a time.
            root.about-open = false;
            fs.focus();
        } else {
            root.dialog-closed();
        }
    }

    property <BlockKind> editing-kind: root.editing-index >= 0 ? root.blocks[root.editing-index].kind : BlockKind.empty;
    property <int> editing-level: root.editing-index >= 0 ? root.blocks[root.editing-index].level : 0;
    property <string> hint: root.editing-index < 0 ? "Click a block to edit its Markdown" : root.editing-kind == BlockKind.heading ? "Heading \{root.editing-level}  ·  edit the #'s, or Ctrl+= / Ctrl+- to change level  ·  Ctrl+0 paragraph  ·  Esc done" : root.editing-kind == BlockKind.list ? "List  ·  Enter next item  ·  Tab / Shift+Tab indent  ·  Enter on empty item ends the list" : root.editing-kind == BlockKind.quote ? "Quote  ·  Enter continues  ·  Enter on an empty line ends the quote" : root.editing-kind == BlockKind.code ? "Code  ·  Enter new line  ·  Tab / Shift+Tab indent  ·  Ctrl+Enter or ↓ at the end leaves the block" : root.editing-kind == BlockKind.table ? "Table  ·  edit the rows as text  ·  Ctrl+Enter adds a paragraph below" : "Text  ·  Ctrl+1…6 heading  ·  Ctrl+B / Ctrl+I  ·  Shift+Enter line break  ·  Esc done";

    // `y` is in list content coordinates.
    function scroll-into-view(y: length, h: length) {
        let top = y - 24px;
        let bottom = y + h + 24px;
        let max-scroll = max(0px, sv.content-height - sv.visible-height);
        if top < -sv.content-y {
            sv.content-y = -max(0px, top);
        } else if bottom > -sv.content-y + sv.visible-height {
            sv.content-y = -min(max-scroll, bottom - sv.visible-height);
        }
    }

    pure function modifiers-of(m: KeyboardModifiers) -> Modifiers {
        return { control: m.control, alt: m.alt, shift: m.shift, meta: m.meta };
    }

    fs := FocusScope {
        // Every key event while anything in the window has the focus passes
        // here first.
        capture-key-released(e) => {
            root.modifiers = root.modifiers-of(e.modifiers);
            return EventResult.reject;
        }
        capture-key-pressed(e) => {
            root.modifiers = root.modifiers-of(e.modifiers);
            // The dialogs are modal. Unsaved changes: Esc cancels, Enter saves.
            if root.confirm-open {
                if e.text == Key.Escape {
                    root.confirm-choice(2);
                } else if e.text == Key.Return {
                    root.confirm-choice(0);
                }
                return EventResult.accept;
            }
            // About: Esc or Enter closes it, other keys do nothing.
            if root.about-open {
                if e.text == Key.Escape || e.text == Key.Return {
                    root.close-about();
                }
                return EventResult.accept;
            }
            if e.modifiers.control && !e.modifiers.alt {
                if e.text == "s" || e.text == "S" {
                    if e.modifiers.shift {
                        root.save-file-as();
                    } else {
                        root.save-file();
                    }
                    return EventResult.accept;
                }
                if e.text == "o" || e.text == "O" {
                    root.open-file();
                    return EventResult.accept;
                }
            }
            return EventResult.reject;
        }
        // Only reached with nothing else focused: the window holds the focus
        // for the block being edited (see park-focus), or nothing is edited.
        key-pressed(e) => {
            if !self.has-focus || root.editing-index < 0 {
                return EventResult.reject;
            }
            if e.text == Key.Escape {
                root.finish-edit();
                return EventResult.accept;
            }
            return root.key-away(e.text, root.modifiers-of(e.modifiers)) ? EventResult.accept : EventResult.reject;
        }

        VerticalLayout {
            // Toolbar
            Rectangle {
                height: 44px;
                background: Theme.chrome;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 14px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 4px;
                    ToolButton {
                        text: "Open…";
                        clicked => {
                            root.open-file();
                        }
                    }
                    ToolButton {
                        text: "Save";
                        clicked => {
                            root.save-file();
                        }
                    }
                    ToolButton {
                        text: "Save As…";
                        clicked => {
                            root.save-file-as();
                        }
                    }
                    Rectangle {
                        width: 12px;
                    }
                    Text {
                        text: root.file-path == "" ? "Untitled — drop a .md file here or press Ctrl+O" : root.file-path;
                        color: Theme.soft;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    ThemeMenu {
                        choose(dark) => {
                            root.choose-theme(dark);
                        }
                    }
                    ToolButton {
                        text: "About";
                        clicked => {
                            root.show-about();
                        }
                    }
                }
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.rule;
                }
            }

            // The document. A ListView only creates the rows in view, so memory
            // and layout work don't grow with the length of the document.
            Rectangle {
                vertical-stretch: 1;

                // The page below a document shorter than the window.
                TouchArea {
                    mouse-cursor: MouseCursor.text;
                    clicked => {
                        root.click-below();
                    }
                }

                sv := ListView {
                    width: parent.width;
                    height: parent.height;
                    mouse-drag-pan-enabled: false;
                    changed content-y => {
                        root.list-scrolled();
                        root.list-moved();
                    }

                    for block[i] in root.blocks: BlockRow {
                        data: block;
                        index: i;
                        first: i == 0;
                        last: i == root.blocks.length - 1;
                        column-x: root.column-x;
                        column-width: root.column-width;
                        editing: i == root.editing-index;
                        edit-seq: root.edit-seq;
                        cursor-request: root.cursor-request;
                        placeholder: root.doc-blank && root.blocks.length == 1;
                        caret-seq: root.caret-seq;
                        saved-caret: root.saved-caret;
                        saved-anchor: root.saved-anchor;
                        ask-seq: root.ask-seq;
                        ask: root.sent-ask;
                        view-top: -sv.content-y;
                        view-height: sv.visible-height;
                        request-edit(index, cursor) => {
                            root.request-edit(index, cursor);
                        }
                        edited(index, text) => {
                            root.edited(index, text);
                        }
                        key-action(index, command, text, cursor, anchor) => {
                            return root.key-action(index, command, text, cursor, anchor);
                        }
                        release-focus => {
                            fs.focus();
                        }
                        caret-moved(index, caret, anchor, caret-y, line-h, scroll) => {
                            if index != root.editing-index {
                                return;
                            }
                            root.caret-seq = root.edit-seq;
                            root.saved-caret = caret;
                            root.saved-anchor = anchor;
                            if scroll {
                                root.scroll-into-view(caret-y, line-h);
                            }
                        }
                        answered(index) => {
                            if index == root.editing-index {
                                root.answered = true;
                                if root.sent-ask == Ask.reveal {
                                    root.want-reveal = false;
                                }
                            }
                        }
                        created(index) => {
                            if index != root.editing-index {
                                return;
                            }
                            // Asked before it existed, the row couldn't answer:
                            // ask again.
                            if root.want-reveal || (root.check-pending && root.sent-ask == Ask.reveal) {
                                root.want-reveal = false;
                                root.ask(Ask.reveal);
                            } else if root.check-pending {
                                root.ask(root.sent-ask);
                            }
                        }
                        focused(index) => {
                            if index == root.editing-index {
                                root.edit-focused();
                            }
                        }
                        click-blank => {
                            root.click-blank();
                        }
                        click-below => {
                            root.click-below();
                        }
                        show-image(index) => {
                            root.show-image(index);
                        }
                    }
                }
            }

            // Status bar
            Rectangle {
                height: 26px;
                background: Theme.chrome;
                Rectangle {
                    y: 0;
                    height: 1px;
                    background: Theme.rule;
                }
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 16px;
                    Text {
                        text: root.status != "" ? root.status : root.hint;
                        color: root.status-error ? Theme.danger : Theme.soft;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: "\{root.words} words  ·  \{root.chars} characters";
                        color: Theme.muted;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
            }
        }

        if root.drop-hover: Rectangle {
            background: Theme.accent.with-alpha(0.08);
            Rectangle {
                x: 16px;
                y: 16px;
                width: parent.width - 32px;
                height: parent.height - 32px;
                border-width: 2px;
                border-color: Theme.accent;
                border-radius: 12px;
                Text {
                    text: "Drop to open";
                    font-size: 22px;
                    color: Theme.accent;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Slint is used under its royalty-free license, which asks for the
        // AboutSlint widget in an About dialog reachable from the top level
        // menu: the toolbar's About button.
        if root.about-open: Rectangle {
            background: Theme.scrim;
            TouchArea {
                clicked => {
                    root.close-about();
                }
                // Don't scroll the document behind the dialog.
                scroll-event(e) => {
                    return EventResult.accept;
                }
            }
            Rectangle {
                width: min(380px, parent.width - 40px);
                height: about.preferred-height;
                background: Theme.page;
                border-radius: 10px;
                drop-shadow-blur: 24px;
                drop-shadow-color: Theme.shadow;
                // Clicks on the card don't close it.
                TouchArea { }
                about := VerticalLayout {
                    padding: 24px;
                    padding-bottom: 20px;
                    spacing: 4px;
                    HorizontalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../assets/linter.png");
                            width: 64px;
                            height: 64px;
                        }
                    }
                    Text {
                        text: "linter";
                        font-size: 20px;
                        font-weight: 700;
                        color: Theme.ink;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Version \{root.version}";
                        font-size: 13px;
                        color: Theme.soft;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "A live-preview Markdown editor";
                        font-size: 13px;
                        color: Theme.soft;
                        horizontal-alignment: center;
                    }
                    Rectangle {
                        height: 17px;
                        Rectangle {
                            y: 12px;
                            height: 1px;
                            background: Theme.rule;
                        }
                    }
                    AboutSlint {
                        height: self.min-height;
                    }
                    Text {
                        text: "Slint is used under the Slint Royalty-free Desktop, Mobile, and Web Applications License 2.0.";
                        font-size: 11px;
                        color: Theme.muted;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                    HorizontalLayout {
                        alignment: center;
                        padding-top: 14px;
                        DialogButton {
                            text: "Close";
                            primary: true;
                            clicked => {
                                root.close-about();
                            }
                        }
                    }
                }
            }
        }

        // Last, so that it shows above the About dialog.
        if root.confirm-open: Rectangle {
            background: Theme.scrim;
            TouchArea {
                // Don't scroll the document behind the dialog.
                scroll-event(e) => {
                    return EventResult.accept;
                }
            }
            Rectangle {
                width: min(440px, parent.width - 40px);
                height: dialog.preferred-height;
                background: Theme.page;
                border-radius: 10px;
                drop-shadow-blur: 24px;
                drop-shadow-color: Theme.shadow;
                dialog := VerticalLayout {
                    padding: 22px;
                    spacing: 18px;
                    Text {
                        text: "Unsaved changes";
                        font-size: 17px;
                        font-weight: 700;
                        color: Theme.ink;
                    }
                    Text {
                        text: root.confirm-text;
                        wrap: word-wrap;
                        color: Theme.soft;
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        DialogButton {
                            text: "Cancel";
                            clicked => {
                                root.confirm-choice(2);
                            }
                        }
                        DialogButton {
                            text: "Don't Save";
                            clicked => {
                                root.confirm-choice(1);
                            }
                        }
                        DialogButton {
                            text: "Save";
                            primary: true;
                            clicked => {
                                root.confirm-choice(0);
                            }
                        }
                    }
                }
            }
        }
    }
}
