// Windows resources for linter.exe: icon, version info and manifest.
// build.rs fills in the @...@ placeholders.
#include <winver.h>

1 ICON "@ICON@"
1 24 "@MANIFEST@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @MAJOR@, @MINOR@, @PATCH@, 0
PRODUCTVERSION @MAJOR@, @MINOR@, @PATCH@, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "linter Markdown editor"
            VALUE "FileVersion", "@VERSION@"
            VALUE "InternalName", "linter"
            VALUE "OriginalFilename", "linter.exe"
            VALUE "ProductName", "linter"
            VALUE "ProductVersion", "@VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
